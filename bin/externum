#!/usr/bin/env python3
"""Externum — minimal bootstrap.

This script is the ONLY Python code needed to run Externum.
Everything else (lexer, parser, compiler) is written in Externum.

The bootstrap:
1. Sets up the VM
2. Loads the Externum compiler (written in .ext)
3. Compiles user source to bytecode
4. Executes via VM
"""

import os
import sys

# Add project root to path for imports
_root = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
if _root not in sys.path:
    sys.path.insert(0, _root)

from externum.vm import VM
from externum.lexer import Lexer
from externum.parser import Parser
from externum.bytecode import BytecodeCompiler


def _compile_source(source: str, module_name: str = '<bootstrap>'):
    """Compile Externum source to a BytecodeModule."""
    from externum.analysis import preprocess
    processed, _ = preprocess(source)
    tokens = Lexer(processed).tokenize()
    ast = list(Parser(tokens).parse())
    compiler = BytecodeCompiler(ast, module_name=module_name)
    return compiler.compile()


def _load_compiler():
    """Load the Externum compiler (written in Externum)."""
    compiler_dir = os.path.join(_root, 'lib', 'compiler')
    if not os.path.isdir(compiler_dir):
        return None

    # Read compiler sources in order
    sources = {}
    for name in ['types', 'tokens', 'lexer', 'parser', 'compiler']:
        path = os.path.join(compiler_dir, f'{name}.ext')
        if os.path.isfile(path):
            with open(path, 'r', encoding='utf-8') as f:
                sources[name] = f.read()

    if not sources:
        return None

    # Combine into single compilation unit
    combined = '# Externum compiler (self-hosted)\n'
    for name in ['types', 'tokens', 'lexer', 'parser', 'compiler']:
        if name in sources:
            combined += f'\n# ── {name} ──\n'
            combined += sources[name]

    return combined


def main(argv=None):
    if argv is None:
        argv = sys.argv[1:]

    if not argv:
        print("Usage: externum <command> [args]")
        print("Commands: run, repl, compile, ide, check, keygen, vm")
        sys.exit(1)

    cmd = argv[0]
    args = argv[1:]

    if cmd == 'run':
        if not args:
            print("Error: externum run requires a file", file=sys.stderr)
            sys.exit(1)
        vm = VM(argv=args[1:])
        source = _read_file(args[0])
        module = _compile_source(source, module_name=args[0])
        vm.run_module(module)

    elif cmd == 'vm':
        if not args:
            print("Error: externum vm requires a file", file=sys.stderr)
            sys.exit(1)
        vm = VM(argv=args[1:])
        source = _read_file(args[0])
        module = _compile_source(source, module_name=args[0])
        vm.run_module(module)

    elif cmd == 'compile':
        if not args:
            print("Error: externum compile requires a file", file=sys.stderr)
            sys.exit(1)
        source = _read_file(args[0])
        module = _compile_source(source, module_name=args[0])
        # Output bytecode
        print(f"# Compiled {args[0]}: {len(module.bytecode)} bytes, {len(module.constants)} constants")

    elif cmd == 'repl':
        _run_repl()

    elif cmd == 'ide':
        # Load and run the TUI IDE
        ide_path = os.path.join(_root, 'lib', 'ide.ext')
        if not os.path.isfile(ide_path):
            print("Error: lib/ide.ext not found", file=sys.stderr)
            sys.exit(1)
        vm = VM(argv=args)
        source = _read_file(ide_path)
        module = _compile_source(source, module_name='ide.ext')
        vm.run_module(module)

    elif cmd == 'keygen':
        from externum.drm import make_license
        import argparse
        p = argparse.ArgumentParser()
        p.add_argument('--app-id', required=True)
        p.add_argument('--author', default='')
        p.add_argument('--secret', required=True)
        p.add_argument('--expires', type=int, default=None)
        p.add_argument('--count', type=int, default=1)
        kargs = p.parse_args(args)
        for _ in range(kargs.count):
            print(make_license(kargs.secret, kargs.app_id, kargs.author, kargs.expires))

    elif cmd == 'check':
        if not args:
            print("Error: externum check requires a file", file=sys.stderr)
            sys.exit(1)
        source = _read_file(args[0])
        from externum.analysis import preprocess, check_or_raise
        from externum.parser import Parser as P
        from externum.lexer import Lexer as L
        processed, _ = preprocess(source)
        tokens = L(processed).tokenize()
        parser = P(tokens)
        ast = parser.parse()
        ast_list = list(ast)
        check_or_raise(ast_list, parser.annotations, parser.signatures,
                       parser.traits, parser.impls, parser.mutable)
        print(f'{args[0]}: all checks passed ✓')

    else:
        # Try as file
        if os.path.isfile(cmd):
            vm = VM(argv=args)
            source = _read_file(cmd)
            module = _compile_source(source, module_name=cmd)
            vm.run_module(module)
        else:
            print(f"Unknown command: {cmd}", file=sys.stderr)
            sys.exit(1)


def _run_repl():
    """Interactive REPL."""
    print("Externum REPL (type 'exit()' to quit)")
    vm = VM()
    buffer = []

    while True:
        try:
            prompt = "ext> " if not buffer else "...   "
            line = input(prompt)
        except (EOFError, KeyboardInterrupt):
            print()
            break

        if line.strip() == 'exit()':
            break

        buffer.append(line)
        source = '\n'.join(buffer)

        try:
            module = _compile_source(source, module_name='<repl>')
            result = vm.run_module(module)
            if result is not None:
                print(result)
            buffer = []
        except SyntaxError as e:
            # Might need more input
            if str(e).startswith('unexpected EOF'):
                continue
            print(f"SyntaxError: {e}")
            buffer = []
        except Exception as e:
            print(f"Error: {e}")
            buffer = []


def _read_file(path: str) -> str:
    try:
        with open(path, 'r', encoding='utf-8') as f:
            return f.read()
    except FileNotFoundError:
        print(f"Error: File '{path}' not found", file=sys.stderr)
        sys.exit(1)


if __name__ == '__main__':
    main()
