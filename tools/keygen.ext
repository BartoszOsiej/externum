# keygen.ext — NV-2.0 / Externum DRM license key generator (100% Externum).
# Issues HMAC-SHA256 signed license keys in the unified base64 format:
#   base64("app_id:author:expires:sig")
# The signing secret is used at build time only and never stored.
#
# Usage:
#   externum run tools/keygen.ext --secret <drm-secret> --app-id nv2-engine \
#     --author "NV-2.0" [--count 50] [--expires <unix-ts>]
#
# Equivalent to:  externum keygen --app-id ... --author ... --secret ...

import drm

def arg_value(args: List[Str], flag: Str, default: Str) -> Str:
    mut i: Int = 0
    while i < len(args):
        if args[i] == flag and i + 1 < len(args):
            return args[i + 1]
        i = i + 1
    return default

def main() -> Int:
    import sys
    args: List[Str] = list(sys.argv[1:])
    secret: Str = arg_value(args, '--secret', '')
    app_id: Str = arg_value(args, '--app-id', 'nv2-engine')
    author: Str = arg_value(args, '--author', 'NV-2.0')
    mut count: Int = 1
    mut expires: Int = 0
    mut c: Str = arg_value(args, '--count', '1')
    try:
        count = int(c)
    except:
        count = 1
    c = arg_value(args, '--expires', '0')
    try:
        expires = int(c)
    except:
        expires = 0
    if secret == '':
        print('keygen: --secret <drm-secret> is required')
        return 2
    print('Externum DRM keygen — ' + app_id + ' :: ' + author + ' (secret never stored)')
    mut i: Int = 0
    while i < count:
        print(drm.make_license(secret, app_id, author, expires))
        i = i + 1
    return 0

main()
