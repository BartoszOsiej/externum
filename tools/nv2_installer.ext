# nv2_installer.ext — NV-2.0 installer (100% Externum, DRM-protected).
# This is the "Externum installer" the player runs to install the game.
# Written entirely in Externum (.ext) and compiled with `--protect`, so the
# shipped artifact is self-contained and self-checking — it does not depend
# on the Externum runtime on the player's machine.
#
# The build script (tools/build_nv2.ext) patches the PATCH_ME_* constants
# per release and compiles this file with `--protect`.
#
# Usage:
#   python3 nv2_installer.ebin --key <license>                 # install
#   python3 nv2_installer.ebin --key <license> --prefix <dir>  # custom dir
#   python3 nv2_installer.ebin --uninstall [--prefix <dir>]    # remove

APP_ID: Str = 'PATCH_ME_APP_ID'
AUTHOR: Str = 'PATCH_ME_AUTHOR'
VERSION: Str = 'PATCH_ME_VERSION'
EXPECTED_LICENSE_SHA: Str = 'PATCH_ME_LICENSE_SHA'
EXPECTED_BINARY_SHA: Str = 'PATCH_ME_BINARY_SHA'
GAME_BINARY: Str = 'PATCH_ME_GAME_BINARY'
LAUNCHER_FILE: Str = 'nv2_launcher.ebin'
PACKAGE_KEY: Str = 'nv2.key'
INSTALL_KEY: Str = 'nv2.lic'
README_FILE: Str = 'README.txt'
EULA_FILE: Str = 'EULA.txt'

# ------------------------------------------------------------- primitives

def file_exists(path: Str) -> Bool:
    import os
    return os.path.isfile(path)

def is_dir(path: Str) -> Bool:
    import os
    return os.path.isdir(path)

def mkdir_p(path: Str) -> Void:
    import os
    if not os.path.isdir(path):
        os.makedirs(path)

def write_file(path: Str, content: Str) -> Void:
    fh: Any = open(path, 'w', encoding='utf-8')
    fh.write(content)
    fh.close()

def read_text(path: Str) -> Str:
    fh: Any = open(path, 'r', encoding='utf-8')
    data: Str = fh.read()
    fh.close()
    return data

def copy_file(src: Str, dst: Str) -> Bool:
    import shutil
    shutil.copy2(src, dst)
    return file_exists(dst)

def remove_file(path: Str) -> Void:
    import os
    try:
        os.remove(path)
    except:
        pass

def remove_tree(path: Str) -> Void:
    import shutil
    if is_dir(path):
        shutil.rmtree(path)

def sha256_file(path: Str) -> Str:
    import hashlib
    fh: Any = open(path, 'rb')
    blob: Any = fh.read()
    fh.close()
    return hashlib.sha256(blob).hexdigest()

def sha256_str(s: Str) -> Str:
    import hashlib
    return hashlib.sha256(s.encode()).hexdigest()

def chmod_x(path: Str) -> Void:
    import os, stat
    os.chmod(path, os.stat(path).st_mode | stat.S_IXUSR | stat.S_IXGRP | stat.S_IXOTH)

def env(name: Str, default: Str) -> Str:
    import os
    return str(os.environ.get(name, default))

def expand_user(path: Str) -> Str:
    import os
    return os.path.expanduser(path)

def script_dir() -> Str:
    import os, sys
    mod: Any = sys.modules.get('__main__')
    fname: Any = getattr(mod, '__file__', None)
    if fname is None:
        return '.'
    return os.path.dirname(os.path.abspath(fname))

def is_windows() -> Bool:
    import os
    return os.name == 'nt'

def path_join(base: Str, name: Str) -> Str:
    import os
    return os.path.join(base, name)

# ------------------------------------------------------------- arg helpers

def has_flag(args: List[Str], flag: Str) -> Bool:
    mut i: Int = 0
    while i < len(args):
        if args[i] == flag:
            return True
        i = i + 1
    return False

def arg_value(args: List[Str], flag: Str, default: Str) -> Str:
    mut i: Int = 0
    while i < len(args):
        if args[i] == flag and i + 1 < len(args):
            return args[i + 1]
        i = i + 1
    return default

# -------------------------------------------------------------- install dir

def default_prefix() -> Str:
    if is_windows():
        mut local: Str = env('LOCALAPPDATA', '')
        if local == '':
            local = expand_user('~')
        return path_join(local, 'NV2')
    mut home: Str = env('XDG_DATA_HOME', '')
    if home == '':
        home = expand_user('~/.local/share')
    return path_join(home, 'nv2')

def find_key(args: List[Str]) -> Str:
    key: Str = arg_value(args, '--key', '')
    if key != '':
        return key
    pkg_key: Str = path_join(script_dir(), PACKAGE_KEY)
    if file_exists(pkg_key):
        return read_text(pkg_key).strip()
    return ''

# ------------------------------------------------------------- install steps

def write_desktop_entry(prefix: Str) -> Void:
    if is_windows():
        bat: Str = '@echo off\r\n' + 'setlocal\r\n' + 'cd /d "%~dp0"\r\n' + 'python3 "%~dp0' + LAUNCHER_FILE + '"\r\n'
        write_file(path_join(prefix, 'nv2_launcher.bat'), bat)
        return
    apps: Str = expand_user('~/.local/share/applications')
    mkdir_p(apps)
    entry: Str = '[Desktop Entry]\n' + 'Version=1.0\n' + 'Type=Application\n' + 'Name=NV-2.0\n' + 'Comment=Voxel survival with real NASA climate\n' + 'Exec=python3 ' + path_join(prefix, LAUNCHER_FILE) + '\n' + 'Terminal=false\n' + 'Categories=Game;Simulation;\n'
    write_file(path_join(apps, 'nv2.desktop'), entry)

def remove_desktop_entry() -> Void:
    if is_windows():
        remove_file(path_join(env('LOCALAPPDATA', expand_user('~')), 'NV2', 'nv2_launcher.bat'))
        return
    remove_file(expand_user('~/.local/share/applications/nv2.desktop'))

def install(args: List[Str]) -> Int:
    key: Str = find_key(args)
    if key == '':
        print('NV-2.0 installer: license key required — pass --key <key> or ship nv2.key')
        return 5
    if sha256_str(key) != EXPECTED_LICENSE_SHA:
        print('NV-2.0 installer: invalid license key')
        return 3

    package: Str = script_dir()
    prefix: Str = arg_value(args, '--prefix', default_prefix())

    src_bin: Str = path_join(package, GAME_BINARY)
    if not file_exists(src_bin):
        print('NV-2.0 installer: missing game binary in package:', src_bin)
        return 4
    print('NV-2.0 installer: installing to', prefix)

    mkdir_p(prefix)
    dst_bin: Str = path_join(prefix, GAME_BINARY)
    if not copy_file(src_bin, dst_bin):
        print('NV-2.0 installer: could not copy game binary')
        return 6
    if not is_windows():
        chmod_x(dst_bin)

    src_launcher: Str = path_join(package, LAUNCHER_FILE)
    if not file_exists(src_launcher):
        print('NV-2.0 installer: missing launcher in package:', src_launcher)
        return 4
    if not copy_file(src_launcher, path_join(prefix, LAUNCHER_FILE)):
        print('NV-2.0 installer: could not copy launcher')
        return 6

    if file_exists(path_join(package, README_FILE)):
        copy_file(path_join(package, README_FILE), path_join(prefix, README_FILE))
    if file_exists(path_join(package, EULA_FILE)):
        copy_file(path_join(package, EULA_FILE), path_join(prefix, EULA_FILE))

    write_file(path_join(prefix, INSTALL_KEY), key)

    if sha256_file(dst_bin) != EXPECTED_BINARY_SHA:
        print('NV-2.0 installer: installed binary failed integrity check')
        return 6

    write_desktop_entry(prefix)

    print('NV-2.0 installer: OK — verified sha256 ' + EXPECTED_BINARY_SHA)
    print('NV-2.0 installer: launch with:')
    print('  python3 ' + path_join(prefix, LAUNCHER_FILE))
    return 0

def uninstall(args: List[Str]) -> Int:
    prefix: Str = arg_value(args, '--prefix', default_prefix())
    print('NV-2.0 installer: removing', prefix)
    remove_tree(prefix)
    remove_desktop_entry()
    print('NV-2.0 installer: uninstalled')
    return 0

# ------------------------------------------------------------------- main

def main() -> Int:
    import sys
    args: List[Str] = list(sys.argv[1:])
    do_uninstall: Bool = has_flag(args, '--uninstall')
    mut code: Int = 0
    if do_uninstall:
        code = uninstall(args)
    else:
        code = install(args)
    return code

main()
