# lib/mathx.ext — math helpers written in Externum (strict language)
# Usage:  import mathx  →  mathx.fib(10)

def clamp(x: Float, lo: Float, hi: Float) -> Float:
    if x < lo:
        return lo
    if x > hi:
        return hi
    return x


def is_even(n: Int) -> Bool:
    return n % 2 == 0


def is_odd(n: Int) -> Bool:
    return not is_even(n)


def gcd(a: Int, b: Int) -> Int:
    while b != 0:
        mut t: Int = b
        b = a % b
        a = t
    return a


def fib(n: Int) -> Int:
    if n <= 1:
        return n
    return fib(n - 1) + fib(n - 2)


def factorial(n: Int) -> Int:
    mut result: Int = 1
    for i in range(2, n + 1):
        result = result * i
    return result


def sum_of_digits(n: Int) -> Int:
    mut total: Int = 0
    s: Str = str(abs(n))
    for ch in s:
        total = total + int(ch)
    return total
